{
  "name": "quiz-streaming-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt generate --preset=static",
    "dev": "node scripts/dev.mjs",
    "dev:nuxt": "nuxt dev --port 3000",
    "dev:worker": "wrangler dev --config wrangler.dev.jsonc --port 8787 --local --show-interactive-dev-session=false",
    "dev:prepare": "wrangler d1 migrations apply DB --local --config wrangler.dev.jsonc",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:scoring": "node --experimental-strip-types --test tests/quizScoring.test.ts",
    "test:audio": "node --experimental-strip-types --test tests/questionAudio.test.ts",
    "deploy": "wrangler deploy -c wrangler.jsonc",
    "deploy:preview": "npm run generate && wrangler versions upload --preview-alias prompt2",
    "deploy:dry-run": "npm run generate && wrangler deploy --dry-run",
    "worker:types": "wrangler types worker-configuration.d.ts --config wrangler.jsonc",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.worker.json --noEmit",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@google/design.md": "^0.3.0",
    "firebase": "^12.16.0",
    "nuxt": "^4.4.8",
    "pdfjs-dist": "^5.7.284",
    "qrcode": "^1.5.4",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260716.1",
    "@types/qrcode": "^1.5.6",
    "typescript": "5.9.3",
    "vue-tsc": "^3.3.7",
    "wrangler": "^4.111.0"
  }
}
